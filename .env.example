# ==============================================================================
# AAROGYA CASE — Production Environment Variables Configuration Template
# ==============================================================================

# Node / Server Port
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://aarogya_user:aarogya_secure_pass@localhost:5432/aarogya_case
DB_HOST=localhost
DB_PORT=5432
DB_USER=aarogya_user
DB_PASSWORD=aarogya_secure_pass
DB_NAME=aarogya_case

# Security & CORS (comma-separated origins allowed for production browser clients)
CORS_ORIGIN=https://aarogya-case.gov.in,https://app.aarogya-case.gov.in

# Persistent Medical Documents Storage (Server path or volume mount)
UPLOAD_DIR=/var/data/aarogya_case/uploads/documents

# Google Gemini Multimodal AI Service (Backend-Only, Never expose to frontend)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-flash-lite-latest

# Session Configuration
SESSION_SECRET=aarogya_case_high_entropy_session_secret_2026_production
SESSION_EXPIRY_HOURS=24
